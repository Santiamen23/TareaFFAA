{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-ucb-dw-ffaa-79464"
		},
		"Destino_DataLake_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'Destino_DataLake'"
		},
		"Origen_ERP_FuerzasArmadas_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'Origen_ERP_FuerzasArmadas'"
		},
		"Destino_DataLake_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://saucbffaa79464.dfs.core.windows.net/"
		},
		"Origen_ERP_FuerzasArmadas_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "server02-fuerzas-armadas-bolivia.database.windows.net"
		},
		"Origen_ERP_FuerzasArmadas_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "erp-fuerzas-armadas-bolivia-2"
		},
		"Origen_ERP_FuerzasArmadas_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "userSisGer"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/Destino_DataLake')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobFS",
				"typeProperties": {
					"url": "[parameters('Destino_DataLake_properties_typeProperties_url')]",
					"accountKey": {
						"type": "SecureString",
						"value": "[parameters('Destino_DataLake_accountKey')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/Origen_ERP_FuerzasArmadas')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('Origen_ERP_FuerzasArmadas_properties_typeProperties_server')]",
					"database": "[parameters('Origen_ERP_FuerzasArmadas_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('Origen_ERP_FuerzasArmadas_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('Origen_ERP_FuerzasArmadas_password')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}