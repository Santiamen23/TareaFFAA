{
	"name": "df_tiempo",
	"properties": {
		"folder": {
			"name": "Gold"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "mb_silver_movs_personal",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "mb_gold_dim_tiempo",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [],
			"scriptLines": [
				"source(output(",
				"          fecha_key as integer,",
				"          fecha as date,",
				"          dia_semana as integer,",
				"          nombre_dia as string,",
				"          dia_mes as integer,",
				"          mes as integer,",
				"          nombre_mes as string,",
				"          trimestre as integer,",
				"          anio as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT DISTINCT \\n    CAST(CONVERT(VARCHAR(8), CAST(fecha_movimiento AS DATE), 112) AS INT) AS fecha_key,\\n    CAST(fecha_movimiento AS DATE) AS fecha,\\n    DATEPART(WEEKDAY, fecha_movimiento) AS dia_semana,\\n    DATENAME(WEEKDAY, fecha_movimiento) AS nombre_dia,\\n    DAY(fecha_movimiento) AS dia_mes,\\n    MONTH(fecha_movimiento) AS mes,\\n    DATENAME(MONTH, fecha_movimiento) AS nombre_mes,\\n    DATEPART(QUARTER, fecha_movimiento) AS trimestre,\\n    YEAR(fecha_movimiento) AS anio\\nFROM silver.tbl_movimientos_personal\\nWHERE fecha_movimiento IS NOT NULL',",
				"     format: 'query') ~> source1",
				"source1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          fecha_key as integer,",
				"          fecha as date,",
				"          dia_semana as integer,",
				"          nombre_dia as string,",
				"          dia_mes as integer,",
				"          mes as integer,",
				"          nombre_mes as string,",
				"          trimestre as integer,",
				"          anio as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}