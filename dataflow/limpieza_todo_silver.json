			"scriptLines": [
				"source(output(",
				"          id_efectivo as string,",
				"          id_especialidad as string,",
				"          id_unidad_actual as string,",
				"          id_rango_actual as string,",
				"          nombre as string,",
				"          ci as string,",
				"          fecha_nacimiento as string,",
				"          genero as string,",
				"          departamento_origen as string,",
				"          fecha_ingreso as string,",
				"          estado as string,",
				"          salario_mensual as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT \\n    TRIM(id_efectivo) AS id_efectivo,\\n    TRIM(id_especialidad) AS id_especialidad,\\n    TRIM(id_unidad_actual) AS id_unidad_actual,\\n    TRIM(id_rango_actual) AS id_rango_actual,\\n    TRIM(nombre) AS nombre,\\n    TRIM(ci) AS ci,\\n    TRIM(fecha_nacimiento) AS fecha_nacimiento,\\n    TRIM(genero) AS genero,\\n    TRIM(departamento_origen) AS departamento_origen,\\n    TRIM(fecha_ingreso) AS fecha_ingreso,\\n    TRIM(estado) AS estado,\\n    TRIM(salario_mensual) AS salario_mensual\\nFROM bronze.tbl_efectivos\\nWHERE id_efectivo IS NOT NULL AND TRIM(id_efectivo) <> \\'\\'',",
				"     format: 'query') ~> Efectivos",
				"source(output(",
				"          id_especialidad as string,",
				"          nombre as string,",
				"          area as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT \\n    TRIM(id_especialidad) AS id_especialidad,\\n    TRIM(nombre) AS nombre,\\n    TRIM(area) AS area\\nFROM bronze.tbl_especialidades\\nWHERE id_especialidad IS NOT NULL AND TRIM(id_especialidad) <> \\'\\'',",
				"     format: 'query') ~> Especialidades",
				"source(output(",
				"          id_estructura as string,",
				"          id_padre as string,",
				"          nivel as string,",
				"          nombre as string,",
				"          sigla as string,",
				"          tipo as string,",
				"          cobertura_departamentos as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT \\n    TRIM(id_estructura) AS id_estructura,\\n    TRIM(id_padre) AS id_padre,\\n    TRIM(nivel) AS nivel,\\n    TRIM(nombre) AS nombre,\\n    TRIM(sigla) AS sigla,\\n    TRIM(tipo) AS tipo,\\n    TRIM(cobertura_departamentos) AS cobertura_departamentos\\nFROM bronze.tbl_estructura_organizacional\\nWHERE id_estructura IS NOT NULL AND TRIM(id_estructura) <> \\'\\'',",
				"     format: 'query') ~> EstructOrg",
				"source(output(",
				"          id_movimiento as string,",
				"          id_efectivo as string,",
				"          id_unidad_destino as string,",
				"          id_rango as string,",
				"          id_tipo as string,",
				"          fecha_movimiento as string,",
				"          antiguedad_anios as string,",
				"          salario_mensual as string,",
				"          observaciones as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT \\n    TRIM(id_movimiento) AS id_movimiento,\\n    TRIM(id_efectivo) AS id_efectivo,\\n    TRIM(id_unidad_destino) AS id_unidad_destino,\\n    TRIM(id_rango) AS id_rango,\\n    TRIM(id_tipo) AS id_tipo,\\n    TRIM(fecha_movimiento) AS fecha_movimiento,\\n    TRIM(antiguedad_anios) AS antiguedad_anios,\\n    TRIM(salario_mensual) AS salario_mensual,\\n    TRIM(observaciones) AS observaciones\\nFROM bronze.tbl_movimientos_personal\\nWHERE id_movimiento IS NOT NULL AND TRIM(id_movimiento) <> \\'\\'',",
				"     format: 'query') ~> MovPersonal",
				"source(output(",
				"          id_operacion as string,",
				"          id_tipo as string,",
				"          id_unidad_resp as string,",
				"          id_zona as string,",
				"          nombre_operacion as string,",
				"          fecha_inicio as string,",
				"          fecha_fin as string,",
				"          efectivos_desplegados as string,",
				"          vehiculos_utilizados as string,",
				"          duracion_dias as string,",
				"          costo_operacion as string,",
				"          resultado as string,",
				"          detenidos as string,",
				"          area_km2 as string,",
				"          incidentes as string,",
				"          observaciones as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT \\n    TRIM(id_operacion) AS id_operacion,\\n    TRIM(id_tipo) AS id_tipo,\\n    TRIM(id_unidad_resp) AS id_unidad_resp,\\n    TRIM(id_zona) AS id_zona,\\n    TRIM(nombre_operacion) AS nombre_operacion,\\n    TRIM(fecha_inicio) AS fecha_inicio,\\n    TRIM(fecha_fin) AS fecha_fin,\\n    TRIM(efectivos_desplegados) AS efectivos_desplegados,\\n    TRIM(vehiculos_utilizados) AS vehiculos_utilizados,\\n    TRIM(duracion_dias) AS duracion_dias,\\n    TRIM(costo_operacion) AS costo_operacion,\\n    TRIM(resultado) AS resultado,\\n    TRIM(detenidos) AS detenidos,\\n    TRIM(area_km2) AS area_km2,\\n    TRIM(incidentes) AS incidentes,\\n    TRIM(observaciones) AS observaciones\\nFROM bronze.tbl_operaciones\\nWHERE id_operacion IS NOT NULL AND TRIM(id_operacion) <> \\'\\'',",
				"     format: 'query') ~> Operaciones",
				"source(output(",
				"          id_rango as string,",
				"          nombre as string,",
				"          categoria as string,",
				"          nivel_jerarquico as string,",
				"          abreviatura as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT \\n    TRIM(id_rango) AS id_rango,\\n    TRIM(nombre) AS nombre,\\n    TRIM(categoria) AS categoria,\\n    TRIM(nivel_jerarquico) AS nivel_jerarquico,\\n    TRIM(abreviatura) AS abreviatura\\nFROM bronze.tbl_rangos\\nWHERE id_rango IS NOT NULL AND TRIM(id_rango) <> \\'\\'',",
				"     format: 'query') ~> Rangos",
				"source(output(",
				"          id_tipo as string,",
				"          nombre as string,",
				"          descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT \\n    TRIM(id_tipo) AS id_tipo,\\n    TRIM(nombre) AS nombre,\\n    TRIM(descripcion) AS descripcion\\nFROM bronze.tbl_tipos_movimiento\\nWHERE id_tipo IS NOT NULL AND TRIM(id_tipo) <> \\'\\'',",
				"     format: 'query') ~> TipoMovs",
				"source(output(",
				"          id_tipo as string,",
				"          nombre as string,",
				"          categoria as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT \\n    TRIM(id_tipo) AS id_tipo,\\n    TRIM(nombre) AS nombre,\\n    TRIM(categoria) AS categoria\\nFROM bronze.tbl_tipos_operacion\\nWHERE id_tipo IS NOT NULL AND TRIM(id_tipo) <> \\'\\'',",
				"     format: 'query') ~> TipoOps",
				"source(output(",
				"          id_unidad as string,",
				"          id_brigada as string,",
				"          nombre as string,",
				"          codigo as string,",
				"          ciudad as string,",
				"          departamento as string,",
				"          tipo_cuartel as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT \\n    TRIM(id_unidad) AS id_unidad,\\n    TRIM(id_brigada) AS id_brigada,\\n    TRIM(nombre) AS nombre,\\n    TRIM(codigo) AS codigo,\\n    TRIM(ciudad) AS ciudad,\\n    TRIM(departamento) AS departamento,\\n    TRIM(tipo_cuartel) AS tipo_cuartel\\nFROM bronze.tbl_unidades\\nWHERE id_unidad IS NOT NULL AND TRIM(id_unidad) <> \\'\\'',",
				"     format: 'query') ~> Unidades",
				"source(output(",
				"          id_zona as string,",
				"          nombre as string,",
				"          departamento as string,",
				"          frontera_con as string,",
				"          tipo_terreno as string,",
				"          altitud_msnm as string,",
				"          nivel_riesgo as string,",
				"          acceso_carretero as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT \\n    TRIM(id_zona) AS id_zona,\\n    TRIM(nombre) AS nombre,\\n    TRIM(departamento) AS departamento,\\n    TRIM(frontera_con) AS frontera_con,\\n    TRIM(tipo_terreno) AS tipo_terreno,\\n    TRIM(altitud_msnm) AS altitud_msnm,\\n    TRIM(nivel_riesgo) AS nivel_riesgo,\\n    TRIM(acceso_carretero) AS acceso_carretero\\nFROM bronze.tbl_zonas\\nWHERE id_zona IS NOT NULL AND TRIM(id_zona) <> \\'\\'',",
				"     format: 'query') ~> Zonas",
				"Especialidades derive(id_especialidad = toInteger(id_especialidad),",
				"          nombre = initCap(regexReplace(trim(nombre), '\\\\s+', ' ')),",
				"          area = initCap(trim(area))) ~> derivedColumn1",
				"Rangos derive(id_rango = toInteger(id_rango),",
				"          nombre = initCap(trim(nombre)),",
				"          categoria = initCap(trim(categoria)),",
				"          nivel_jerarquico = toInteger(nivel_jerarquico),",
				"          abreviatura = upper(trim(abreviatura))) ~> derivedColumn2",
				"TipoMovs derive(id_tipo = toInteger(id_tipo),",
				"          nombre = initCap(trim(nombre)),",
				"          descripcion = trim(descripcion)) ~> derivedColumn3",
				"TipoOps derive(id_tipo = toInteger(id_tipo),",
				"          nombre = initCap(trim(nombre)),",
				"          categoria = initCap(trim(categoria))) ~> derivedColumn4",
				"Unidades derive(id_unidad = toInteger(id_unidad),",
				"          id_brigada = toInteger(id_brigada),",
				"          nombre = initCap(regexReplace(trim(nombre), '\\\\s+', ' ')),",
				"          codigo = upper(trim(codigo)),",
				"          ciudad = initCap(trim(ciudad)),",
				"          departamento = case(  in(['cba', 'cbba', 'cochabamba', 'cocha','cbba.'], lower(trim(departamento))), 'Cochabamba',  in(['lpz', 'la paz', 'lp', 'lapaz','l.p.','l.p'], lower(trim(departamento))), 'La Paz',  in(['scz', 'santa cruz', 'sta cruz', 'santacruz','sta. cruz','sc'], lower(trim(departamento))), 'Santa Cruz',  in(['oru', 'oruro','or','or.'], lower(trim(departamento))), 'Oruro',  in(['pot', 'potosi', 'potosí', 'pts','pt.'], lower(trim(departamento))), 'Potosí',  in(['tja', 'tarija'], lower(trim(departamento))), 'Tarija',  in(['chu', 'chuquisaca', 'sucre'], lower(trim(departamento))), 'Chuquisaca',  in(['ben', 'beni','ben.','bn.','bn'], lower(trim(departamento))), 'Beni',  in(['pan', 'pando','pn'], lower(trim(departamento))), 'Pando',  initCap(trim(departamento))),",
				"          tipo_cuartel = initCap(trim(tipo_cuartel))) ~> derivedColumn5",
				"Zonas derive(id_zona = toInteger(id_zona),",
				"          nombre = initCap(regexReplace(trim(nombre), '\\\\s+', ' ')),",
				"          departamento = case(  in(['cba', 'cbba', 'cochabamba', 'cocha','cbba.'], lower(trim(departamento))), 'Cochabamba',  in(['lpz', 'la paz', 'lp', 'lapaz','l.p.','l.p'], lower(trim(departamento))), 'La Paz',  in(['scz', 'santa cruz', 'sta cruz', 'santacruz','sta. cruz','sc'], lower(trim(departamento))), 'Santa Cruz',  in(['oru', 'oruro','or','or.'], lower(trim(departamento))), 'Oruro',  in(['pot', 'potosi', 'potosí', 'pts','pt.'], lower(trim(departamento))), 'Potosí',  in(['tja', 'tarija'], lower(trim(departamento))), 'Tarija',  in(['chu', 'chuquisaca', 'sucre'], lower(trim(departamento))), 'Chuquisaca',  in(['ben', 'beni','ben.','bn.','bn'], lower(trim(departamento))), 'Beni',  in(['pan', 'pando','pn'], lower(trim(departamento))), 'Pando',  initCap(trim(departamento))),",
				"          frontera_con = initCap(trim(frontera_con)),",
				"          tipo_terreno = initCap(trim(tipo_terreno)),",
				"          altitud_msnm = toInteger(regexReplace(toString(altitud_msnm), '[^0-9]', '')),",
				"          nivel_riesgo = upper(trim(nivel_riesgo)),",
				"          acceso_carretero = iif(in(['si','true','1','yes', 'SÍ', 's', 'y'], lower(trim(toString(acceso_carretero)))), true(), false())) ~> derivedColumn6",
				"Operaciones derive(id_operacion = toInteger(id_operacion),",
				"          id_tipo = toInteger(id_tipo),",
				"          id_unidad_resp = toInteger(id_unidad_resp),",
				"          id_zona = toInteger(id_zona),",
				"          nombre_operacion = initCap(regexReplace(trim(nombre_operacion), '\\\\s+', ' ')),",
				"          fecha_inicio = coalesce(   toDate(trim(fecha_inicio), 'yyyy-MM-dd'),   toDate(trim(fecha_inicio), 'yyyy/MM/dd'),   toDate(trim(fecha_inicio), 'dd/MM/yyyy'),   toDate(trim(fecha_inicio), 'dd-MM-yyyy'),   toDate(trim(fecha_inicio), 'MM-dd-yyyy'),   toDate(trim(fecha_inicio), 'yyyyMMdd'),      /* --- Manejo de meses en texto (ABR, agosto, etc) --- */   /* Formato: \"abril 18, 2024\" o \"agosto 13, 2023\" */   toDate(regexReplace(lower(fecha_inicio), 'abril|abr', '04'), 'MM dd, yyyy'),   toDate(regexReplace(lower(fecha_inicio), 'agosto|ago', '08'), 'MM dd, yyyy'),      /* Formato: \"22/ABR/2024\" o \"30/ABR/2025\" */   toDate(regexReplace(lower(fecha_inicio), 'abril|abr', '04'), 'dd/MM/yyyy'),   toDate(regexReplace(lower(fecha_inicio), 'agosto|ago', '08'), 'dd/MM/yyyy') ),",
				"          fecha_fin = coalesce(   toDate(trim(fecha_fin), 'yyyy-MM-dd'),   toDate(trim(fecha_fin), 'dd/MM/yyyy'),   toDate(trim(fecha_fin), 'dd-MM-yyyy'),   toDate(trim(fecha_fin), 'MM-dd-yyyy'),   toDate(trim(fecha_fin), 'yyyy/MM/dd'),   toDate(trim(fecha_fin), 'yyyyMMdd') ),",
				"          efectivos_desplegados = toInteger(\r",
				"  iifNull(\r",
				"    case(\r",
				"      regexMatch(lower(toString(efectivos_desplegados)), '.*\\\\b(cien|ciento)\\\\b.*'), '100',\r",
				"      regexMatch(lower(toString(efectivos_desplegados)), '.*\\\\b(doscientos)\\\\b.*'), '200',\r",
				"      regexMatch(lower(toString(efectivos_desplegados)), '.*\\\\b(trescientos)\\\\b.*'), '300',\r",
				"      regexMatch(lower(toString(efectivos_desplegados)), '.*\\\\b(cuatrocientos)\\\\b.*'), '400',\r",
				"      regexMatch(lower(toString(efectivos_desplegados)), '.*\\\\b(veinte)\\\\b.*'), '20',\r",
				"      regexMatch(lower(toString(efectivos_desplegados)), '.*\\\\b(diez)\\\\b.*'), '10',\r",
				"      regexReplace(toString(efectivos_desplegados), '[^0-9]', '')\r",
				"    ), \r",
				"  '0')\r",
				"),",
				"          vehiculos_utilizados = toInteger(\r",
				"  iifNull(\r",
				"    case(\r",
				"      regexMatch(lower(toString(vehiculos_utilizados)), '.*\\\\b(cien|ciento)\\\\b.*'), '100',\r",
				"      regexMatch(lower(toString(vehiculos_utilizados)), '.*\\\\b(doscientos)\\\\b.*'), '200',\r",
				"      regexMatch(lower(toString(vehiculos_utilizados)), '.*\\\\b(trescientos)\\\\b.*'), '300',\r",
				"      regexMatch(lower(toString(vehiculos_utilizados)), '.*\\\\b(cuatrocientos)\\\\b.*'), '400',\r",
				"      regexMatch(lower(toString(vehiculos_utilizados)), '.*\\\\b(veinte)\\\\b.*'), '20',\r",
				"      regexMatch(lower(toString(vehiculos_utilizados)), '.*\\\\b(diez)\\\\b.*'), '10',\r",
				"      regexReplace(toString(vehiculos_utilizados), '[^0-9]', '')\r",
				"    ), \r",
				"  '0')\r",
				"),",
				"          duracion_dias = toInteger(regexReplace(toString(duracion_dias), '[^0-9]', '')),",
				"          costo_operacion = toDecimal(   iif(     isNull(regexExtract(replace(toString(costo_operacion), ',', ''), '([0-9]+[.]?[0-9]*)', 1)) || regexExtract(replace(toString(costo_operacion), ',', ''), '([0-9]+[.]?[0-9]*)', 1) == '',     toString(null()),     regexExtract(replace(toString(costo_operacion), ',', ''), '([0-9]+[.]?[0-9]*)', 1)   ),    18, 2 ),",
